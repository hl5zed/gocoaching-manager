{
  "name": "gocoaching-manager",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "clean": "npx rimraf .next",
    "clean:dev": "npm run clean && npm run dev",
    "check:debug-routes": "node --experimental-strip-types scripts/check-debug-routes.ts",
    "check:invitation-rules": "node --experimental-strip-types scripts/check-invitation-rules.ts",
    "check:all": "npm run typecheck && npm run check:debug-routes && npm run check:invitation-rules && npm run check:csp-report",
    "check:csp-report": "node --experimental-strip-types scripts/check-csp-report-route.ts",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:check": "node scripts/i18n-check-missing-keys.mjs",
    "verify:i18n": "npm run i18n:check && npm run i18n:audit",
    "build": "npm run typecheck && npm run check:debug-routes && next build",
    "start": "next start",
    "lint": "echo \"ESLint config not found; skipping lint.\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "next": "^16.2.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^6.0.3"
  }
}
