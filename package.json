{
  "name": "gocoaching-manager",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "check:debug-routes": "node --experimental-strip-types scripts/check-debug-routes.ts",
    "check:invitation-rules": "node --experimental-strip-types scripts/check-invitation-rules.ts",
    "check:all": "npm run typecheck && npm run check:debug-routes && npm run check:invitation-rules",
    "build": "npm run check:debug-routes && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "clsx": "^2.1.1",
    "next": "^16.2.4",
    "nodemailer": "^8.0.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "supabase": "^2.98.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^6.0.3"
  }
}
